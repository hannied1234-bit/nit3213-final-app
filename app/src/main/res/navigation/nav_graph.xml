<?xml version="1.0" encoding="utf-8"?>
<!--
    Navigation graph (Lecture 4). It lists the three screens (destinations), the
    actions that move between them, and the arguments each screen receives.
    Safe Args reads this file and generates LoginFragmentDirections,
    DashboardFragmentDirections and DetailsFragmentArgs.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.vu.nit3213app.ui.login.LoginFragment"
        android:label="@string/title_login"
        tools:layout="@layout/fragment_login">

        <!-- popUpTo with inclusive="true" removes Login from the back stack, so
             pressing Back on the Dashboard closes the app instead of returning
             to the login form. -->
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.vu.nit3213app.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard">

        <!-- The keypass returned by the login endpoint. -->
        <argument
            android:name="keypass"
            app:argType="string" />

        <action
            android:id="@+id/action_dashboardFragment_to_detailsFragment"
            app:destination="@id/detailsFragment"
            app:enterAnim="@anim/slide_in_end"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/slide_out_end" />

        <!-- Log out: go back to Login and clear the Dashboard from the back stack. -->
        <action
            android:id="@+id/action_dashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popUpTo="@id/dashboardFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.vu.nit3213app.ui.details.DetailsFragment"
        android:label="@string/title_details"
        tools:layout="@layout/fragment_details">

        <!-- The whole selected Entity, passed as a Parcelable. -->
        <argument
            android:name="entity"
            app:argType="com.vu.nit3213app.domain.model.Entity" />
    </fragment>

</navigation>
