<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 colour roles for light mode, built around a deep blue primary.
    The same names are redefined in values-night/colors.xml for dark mode, so the
    theme switches palette automatically without any code.
-->
<resources>
    <color name="md_primary">#2F5DA8</color>
    <color name="md_on_primary">#FFFFFF</color>
    <color name="md_primary_container">#D9E2FF</color>
    <color name="md_on_primary_container">#001A43</color>

    <color name="md_secondary">#575E71</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#DBE2F9</color>
    <color name="md_on_secondary_container">#141B2C</color>

    <color name="md_tertiary">#715573</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#FBD7FC</color>
    <color name="md_on_tertiary_container">#29132D</color>

    <color name="md_error">#BA1A1A</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#FFDAD6</color>
    <color name="md_on_error_container">#410002</color>

    <color name="md_surface">#F9F9FF</color>
    <color name="md_on_surface">#1A1B20</color>
    <color name="md_surface_variant">#E1E2EC</color>
    <color name="md_on_surface_variant">#44474F</color>
    <color name="md_outline">#757780</color>
    <color name="md_outline_variant">#C5C6D0</color>

    <color name="md_surface_container_lowest">#FFFFFF</color>
    <color name="md_surface_container_low">#F3F3FA</color>
    <color name="md_surface_container">#EDEDF4</color>
    <color name="md_surface_container_high">#E7E8EE</color>
    <color name="md_surface_container_highest">#E2E2E9</color>

    <!-- Launcher icon background stays the same in light and dark mode. -->
    <color name="ic_launcher_background">#2F5DA8</color>
</resources>
